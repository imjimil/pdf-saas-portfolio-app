# Local development uses 5001 because macOS AirPlay Receiver occupies 5000.
PORT=5001
NODE_ENV=development

# Optional. Without it, conversions still work but accounts and history do not.
# Include the database name before the "?" and percent-encode special
# characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mypdftools?retryWrites=true&w=majority

# Any long random strings. Generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# The origin allowed by CORS.
FRONTEND_URL=http://localhost:3000

# Google sign-in (optional).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Cloud OCR fallback, used only when Tesseract is not installed (optional).
OCR_SPACE_API_KEY=

# Upload limit in megabytes.
MAX_UPLOAD_MB=50
