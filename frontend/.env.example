# Where the frontend sends API requests.
#
# Local development: leave this relative. Requests then go through the Vite dev
# proxy defined in vite.config.ts, which forwards /api to the backend on port
# 5001. A relative path also works when you open the site from another device on
# the same network (a phone, for example), where "localhost" would mean that
# device rather than your computer.
VITE_API_URL=/api

# Production (Vercel): set this to the full URL of the deployed backend, e.g.
# VITE_API_URL=https://mypdftools-qhub.onrender.com/api
